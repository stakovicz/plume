<?xml version="1.0" encoding="utf-8"?>
<!-- Artifact configuration of the SignPath project "plume" (paste it in signpath.io): the workflow uploads a zip
     holding the Windows installers, flat (release.yml, "Installers to sign"). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*-setup.exe" max-matches="unbounded">
      <authenticode-sign/>
    </pe-file>
    <msi-file path="*.msi" min-matches="0" max-matches="unbounded">
      <authenticode-sign/>
    </msi-file>
  </zip-file>
</artifact-configuration>
