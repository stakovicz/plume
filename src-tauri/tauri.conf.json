{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plume",
  "version": "../package.json",
  "identifier": "cz.stakovi.plume",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Plume",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "plm"
        ],
        "name": "Plume document",
        "description": "Plume document",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-plume",
        "exportedType": {
          "identifier": "cz.stakovi.plume.document",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ],
    "macOS": {
      "files": {
        "Resources/plm.icns": "icons/plm.icns"
      }
    }
  }
}
